algoritmo "semnome"

var

 NOTAS    : VETOR [1..5,1..5] DE REAL
 ALUNO    : INTEIRO
 BIMESTRE : INTEIRO
 NOME     : VETOR [1..5] DE CARACTER
 
inicio

ESCREVAL("INFORME O NOME DE TODOS OS ALUNOS")
PARA ALUNO DE 1 ATE 5 FACA
  LEIA(NOME[ALUNO])
FIMPARA

ESCREVAL("DIGITE AS NOTAS DO ALUNO")
PARA BIMESTRE DE 1 ATE 4 FACA
  ESCREVAL(BIMESTRE, "BIM = ")
  PARA ALUNO DE 1 ATE 5 FACA
    ESCREVA(NOME[ALUNO], ": ")
    LEIA(NOTAS[ALUNO,BIMESTRE])
   FIMPARA
FIMPARA
ESCREVAL


PARA ALUNO DE 1 ATE 5 FACA
   NOTAS[ALUNO,5] <- (NOTAS[ALUNO,1] + NOTAS[ALUNO,2] + NOTAS[ALUNO,3] + NOTAS[ALUNO,4]) / 4
FIMPARA


ESCREVAL
ESCREVAL("RESULTADO:")

PARA ALUNO DE 1 ATE 5 FACA
  ESCREVAL(ALUNO, " - ", NOME[ALUNO], ": ")
  ESCREVA(NOTAS[ALUNO,5]:2:2, " = ")
  SE NOTAS[ALUNO,5] < 5 ENTAO
      ESCREVAL("REPROVADO")
    SENAO
      SE NOTAS[ALUNO,5] < 7 ENTAO
          ESCREVAL("RECUPERACAO")
        SENAO
          ESCREVAL("APROVADO")
      FIMSE
  FIMSE
  ESCREVAL
FIMPARA


fimalgoritmo
