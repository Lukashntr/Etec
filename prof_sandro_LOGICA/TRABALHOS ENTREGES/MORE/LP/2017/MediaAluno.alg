algoritmo "semnome"

var

 BIM1 : VETOR [1..5] DE REAL
 BIM2 : VETOR [1..5] DE REAL
 BIM3 : VETOR [1..5] DE REAL
 BIM4 : VETOR [1..5] DE REAL
 
 CONTADOR : INTEIRO
 
 MEDIA : VETOR [1..5] DE REAL
 
 NOME : VETOR [1..5] DE CARACTER
 
inicio

ESCREVAL("INFORME O NOME DE TODOS OS ALUNOS")
PARA CONTADOR DE 1 ATE 5 FACA
  LEIA(NOME[CONTADOR])
FIMPARA


ESCREVAL("DIGITE AS NOTAS DO 1 BIMESTRE")
PARA CONTADOR DE 1 ATE 5 FACA
  ESCREVA(NOME[CONTADOR], ": ")
  LEIA(BIM1[CONTADOR])
FIMPARA
ESCREVAL

ESCREVAL("DIGITE AS NOTAS DO 2 BIMESTRE")
PARA CONTADOR DE 1 ATE 5 FACA
  ESCREVA(NOME[CONTADOR], ": ")
  LEIA(BIM2[CONTADOR])
FIMPARA
ESCREVAL

ESCREVAL("DIGITE AS NOTAS DO 3 BIMESTRE")
PARA CONTADOR DE 1 ATE 5 FACA
  ESCREVA(NOME[CONTADOR], ": ")
  LEIA(BIM3[CONTADOR])
FIMPARA
ESCREVAL

ESCREVAL("DIGITE AS NOTAS DO 4 BIMESTRE")
PARA CONTADOR DE 1 ATE 5 FACA
  ESCREVA(NOME[CONTADOR], ": ")
  LEIA(BIM4[CONTADOR])
FIMPARA
ESCREVAL

PARA CONTADOR DE 1 ATE 5 FACA
   MEDIA[CONTADOR] <- (BIM1[CONTADOR] + BIM2[CONTADOR] + BIM3[CONTADOR] + BIM4[CONTADOR]) / 4
FIMPARA

ESCREVAL
ESCREVAL("RESULTADO:")

PARA CONTADOR DE 1 ATE 5 FACA
  ESCREVAL(CONTADOR, " - ", NOME[CONTADOR], ": ")
  ESCREVA(MEDIA[CONTADOR]:2:2, " = ")
  SE MEDIA[CONTADOR] < 5 ENTAO
      ESCREVAL("REPROVADO")
    SENAO
      SE MEDIA[CONTADOR] < 7 ENTAO
          ESCREVAL("RECUPERACAO")
        SENAO
          ESCREVAL("APROVADO")
      FIMSE
  FIMSE
  ESCREVAL
FIMPARA


fimalgoritmo
