algoritmo "semnome"
// Função :
// Autor :
// Data : 20/06/2017
// Seção de Declarações 
var
calendar: vetor[1..5, 1..2] de inteiro

validador: vetor[1..5] de inteiro

c: inteiro
inicio
// Seção de Comandos 
escreva ("Digite o dia:")
leia (calendar[1,1])

para c

se calendar[1,1] > 31 entao
   escreval ("Dia inválido")
   senao
   se
fimse

fimalgoritmo














