algoritmo "semnome"

var
   CONTADOR    : INTEIRO
   FREQUENCIA  : REAL
   QTDE_ALUNOS : INTEIRO
   SOMA        : REAL
   MEDIA       : REAL
   NOTA        : REAL
   SOMANOTA    : REAL
   MEDIANOTA   : REAL
inicio

ESCREVAL("INFORME A QTDE DE ALUNOS")
LEIA(QTDE_ALUNOS)
CONTADOR <- 1
ENQUANTO CONTADOR <= QTDE_ALUNOS FACA
     ESCREVAL("ALUNO ", CONTADOR)
     ESCREVA(" FRENQUENCIA : ")
     LEIA(FREQUENCIA)
     ESCREVA(" NOTA        : ")
     LEIA(NOTA)
     CONTADOR <- CONTADOR + 1
     SOMA     <- SOMA + FREQUENCIA
     SOMANOTA <- SOMANOTA + NOTA
FIMENQUANTO

MEDIANOTA <- SOMANOTA / QTDE_ALUNOS
MEDIA <- SOMA / QTDE_ALUNOS
ESCREVA("A MEDIA DE FREQUENCIA DA TURMA É : ", MEDIA :2:2)

SE MEDIA >= 94 ENTAO
     ESCREVAL(" - FREQUENCIA OTIMA")
   SENAO
     SE MEDIA >= 87 ENTAO
         ESCREVAL(" - FREQUENCIA BOA")
       SENAO
         SE MEDIA >= 75 ENTAO
             ESCREVAL(" - FREQUENCIA REGULAR")
           SENAO
             ESCREVAL(" - FREQUENCIA RUIM")
         FIMSE
     FIMSE
FIMSE

ESCREVA("A MEDIA DE NOTA DA TURMA         : ", MEDIANOTA :2:2)

SE MEDIANOTA >= 8 ENTAO
     ESCREVA(" - APROVEITAMENTO OTIMO")
   SENAO
     SE MEDIANOTA >= 6 ENTAO
         ESCREVA(" - APROVEITAMENTO BOM")
       SENAO
         SE MEDIANOTA >= 5 ENTAO
             ESCREVA(" - APROVEITAMENTO REGULAR")
           SENAO
             ESCREVA(" - APROVEITAMENTO RUIM")
         FIMSE
     FIMSE
FIMSE


fimalgoritmo
